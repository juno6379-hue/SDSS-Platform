{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GMAIS Job Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_id",
    "capability_id",
    "input_refs",
    "aoi",
    "requested_outputs",
    "execution_context"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uri": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "aoi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bbox",
        "crs"
      ],
      "properties": {
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "crs": {
          "type": "string",
          "pattern": "^(EPSG:[0-9]+|OGC:CRS84)$"
        },
        "geometry_uri": {
          "type": "string"
        }
      }
    },
    "time_range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "model_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "uri": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameters": {
      "type": "object"
    },
    "requested_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "purpose",
        "environment"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "enum": [
            "development",
            "staging",
            "production"
          ]
        },
        "approval_ref": {
          "type": "string"
        },
        "workflow_run_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      }
    }
  }
}
