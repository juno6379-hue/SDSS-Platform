{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GMAIS Job Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "agent_id",
    "status",
    "trace_id",
    "submitted_at",
    "progress"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "CREATED",
        "VALIDATING",
        "BLOCKED",
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "result_id": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    }
  }
}
