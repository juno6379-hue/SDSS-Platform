{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GMAIS Update Ticket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ticket_id",
    "model_ref",
    "update_type",
    "trigger",
    "proposed_inputs",
    "validation_plan",
    "approval_state"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "ticket_id": {
      "type": "string",
      "minLength": 1
    },
    "model_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "uri": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "update_type": {
      "enum": [
        "RETRAINING",
        "RECALIBRATION",
        "CONFIG_UPDATE",
        "EXTERNAL_RELEASE"
      ]
    },
    "trigger": {
      "enum": [
        "DRIFT",
        "NEW_DATA",
        "BUG",
        "SCIENTIFIC_REVIEW",
        "PERFORMANCE_DEGRADATION"
      ]
    },
    "proposed_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uri": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "baseline_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "uri": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parameters_ref": {
      "type": "string"
    },
    "validation_plan": {
      "type": "object",
      "required": [
        "independent_test_ref",
        "metrics",
        "acceptance_threshold_ref"
      ],
      "properties": {
        "independent_test_ref": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_threshold_ref": {
          "type": "string",
          "minLength": 1
        },
        "holdout_policy": {
          "type": "string"
        },
        "physical_consistency_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "approval_state": {
      "enum": [
        "PROPOSED",
        "DATA_READY",
        "VALIDATED",
        "APPROVED",
        "REJECTED",
        "DEPLOYED"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
