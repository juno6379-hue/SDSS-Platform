{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GMAIS Result Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "job_id",
    "agent_id",
    "status",
    "output_assets",
    "input_refs",
    "spatial",
    "validation",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "SCIENTIFIC_VALIDATED",
        "DEVELOPMENT_ONLY",
        "MOCK_ONLY"
      ]
    },
    "model_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "uri": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "uri",
          "sha256"
        ],
        "properties": {
          "type": {
            "enum": [
              "COG",
              "GeoJSON",
              "GeoPackage",
              "NetCDF",
              "Parquet",
              "CSV",
              "JSON",
              "PDF"
            ]
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "units": {
            "type": "string"
          }
        }
      }
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uri": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bbox",
        "crs"
      ],
      "properties": {
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "crs": {
          "type": "string",
          "pattern": "^(EPSG:[0-9]+|OGC:CRS84)$"
        },
        "geometry_uri": {
          "type": "string"
        }
      }
    },
    "time_range": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "uncertainty": {
      "type": "object"
    },
    "validation": {
      "type": "object",
      "required": [
        "validation_level",
        "report_ref"
      ],
      "properties": {
        "validation_level": {
          "enum": [
            "CONTRACT_ONLY",
            "PSEUDO_LABEL_AGREEMENT",
            "INDEPENDENT_SCIENTIFIC"
          ]
        },
        "report_ref": {
          "type": "string",
          "minLength": 1
        },
        "metric_summary": {
          "type": "object"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "trace_id",
        "processing_version"
      ],
      "properties": {
        "trace_id": {
          "type": "string",
          "minLength": 1
        },
        "processing_version": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "uri": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
