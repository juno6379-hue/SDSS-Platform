{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GMAIS Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "version",
    "source",
    "data_type",
    "spatial",
    "temporal",
    "quality_status",
    "access_class",
    "sha256",
    "artifact_uri",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "institution",
        "product",
        "license"
      ],
      "properties": {
        "institution": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string"
        }
      }
    },
    "data_type": {
      "enum": [
        "raster",
        "vector",
        "timeseries",
        "table",
        "document"
      ]
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bbox",
        "crs"
      ],
      "properties": {
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "crs": {
          "type": "string",
          "pattern": "^(EPSG:[0-9]+|OGC:CRS84)$"
        },
        "geometry_uri": {
          "type": "string"
        }
      }
    },
    "temporal": {
      "type": "object",
      "required": [
        "start",
        "end",
        "calendar"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "calendar": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "units": {
      "type": "string"
    },
    "resolution": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "no_data": {},
    "quality_status": {
      "enum": [
        "RAW",
        "STAGED",
        "STANDARDIZED",
        "VALIDATED",
        "REJECTED"
      ]
    },
    "quality_report_ref": {
      "type": "string"
    },
    "access_class": {
      "enum": [
        "PUBLIC",
        "RESTRICTED",
        "CONFIDENTIAL"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_uri": {
      "type": "string",
      "minLength": 1
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "uri": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
